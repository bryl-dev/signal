# Copy to .env in the repo root (Compose) and/or apps/api/.env

# --- API ---
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://signal:signal@localhost:5432/signal
DATABASE_URL_SYNC=postgresql+psycopg2://signal:signal@localhost:5432/signal
REDIS_URL=redis://localhost:6379/0

# Generate a long random string before any deploy.
JWT_SECRET=dev-only-change-me-use-a-long-random-string
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
